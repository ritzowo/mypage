{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritzu-web",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Note: カスタムドメイン(ritzu.dev)の紐付けは OpenTofu(infra)側で管理する。
  // ここには routes を書かない。wrangler はコードデプロイのみ担当。
}
